# Copier en .env et remplir en local. Sur Render, renseigner ces variables dans le dashboard.

# Génère une valeur avec : openssl rand -hex 32
JWT_SECRET=

# Compte super_admin créé automatiquement au premier démarrage
ADMIN_EMAIL=admin@melora.example
ADMIN_PASSWORD=change-moi

# Laisser vide en local (utilise un fichier SQLite local automatiquement).
# En production : créer une base sur turso.tech puis renseigner ces deux valeurs.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

PORT=4000
