# Copier en .env et remplir en local. Sur Render, renseigner ces variables dans le dashboard.

# Génère une valeur avec : openssl rand -hex 32
JWT_SECRET=

# Compte super_admin créé automatiquement au premier démarrage
ADMIN_EMAIL=admin@melora.example
ADMIN_PASSWORD=change-moi

# Laisser vide en local (utilise un fichier SQLite local automatiquement).
# En production : créer une base sur turso.tech puis renseigner ces deux valeurs.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

PORT=4000

# Notifications push (Web Push / VAPID) — indispensable pour prévenir quelqu'un même
# onglet fermé ou pendant une veille Render (~15 min d'inactivité, réveil 30-50s).
# Génère la paire de clés avec : npm run vapid:generate  (ou npx web-push generate-vapid-keys)
# Laisser vide : l'app fonctionne quand même, juste sans notifications push (SSE seul).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ton-domaine.example

# TURN (optionnel) — relais media WebRTC pour les appels sur réseaux restrictifs
# (NAT symétrique, certains Wi-Fi d'entreprise). Le STUN public suffit sans ça dans la
# majorité des cas. Un compte gratuit metered.ca fournit ces trois valeurs.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
